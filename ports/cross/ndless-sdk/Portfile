# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           boost 1.0

name                ndless-sdk
version             0-devel
revision            0
categories          cross devel
platforms           {darwin >= 20}
supported_archs     x86_64 arm64
maintainers         nomaintainer
license             MPL-1.1 GPL-3+ BSD MIT zlib

description         Ndless SDK and ARM toolchain for TI-Nspire calculators
long_description    The development version of the Ndless SDK includes an ARM \
                    C/C++ toolchain, Python-enabled GDB, development tools, \
                    libraries, samples and calculator programs.
homepage            https://github.com/ndless-nspire/Ndless

fetch.type          git
git.url             https://github.com/ndless-nspire/Ndless.git
git.branch          {}
livecheck.type      none

universal_variant   no
use_configure       no
compiler.c_standard 2017
compiler.cxx_standard 2011

# Use current curl for downloads.
depends_fetch-append \
                    port:curl
depends_build-append \
                    port:bison \
                    port:coreutils \
                    port:flex \
                    port:gmake \
                    port:php84 \
                    port:texinfo \
                    path:bin/pkg-config:pkgconfig \
                    bin:xxd:vim
depends_lib-append  port:expat \
                    port:gettext-runtime \
                    port:gmp \
                    port:libiconv \
                    port:libmpc \
                    port:mpfr \
                    port:ncurses \
                    port:python313 \
                    port:xz \
                    port:zlib \
                    port:zstd
depends_run-append  port:bash \
                    port:coreutils \
                    port:gmake

set tools           ${workpath}/ndless-tools
set sdk             ${prefix}/lib/ndless-sdk

post-fetch {
    system -W ${worksrcpath} "${git.cmd} submodule update --init --recursive"
    # Fetch toolchain sources before sandboxing.
    system -W ${worksrcpath}/ndless-sdk/toolchain \
        "env PATH=[shellescape ${prefix}/bin:/usr/bin:/bin:/usr/sbin:/sbin] /bin/sh ./build_toolchain.sh --download-only"
    system -W ${worksrcpath}/ndless-sdk/toolchain/download/gcc-14.2.0 \
        "/usr/bin/patch -p1 < [shellescape ${worksrcpath}/.github/packaging/gcc-setlocale.patch]"
}

pre-build {
    file mkdir ${tools}
    foreach {cmd target} [list make ${prefix}/bin/gmake \
                              php ${prefix}/bin/php84 \
                              python3 ${prefix}/bin/python3.13] {
        ln -sf ${target} ${tools}/${cmd}
    }

    # Keep host flags in compiler wrappers.
    foreach {cmd compiler flags} [list gcc ${configure.cc} ${configure.cc_archflags} \
                                      g++ ${configure.cxx} ${configure.cxx_archflags}] {
        if {${configure.sdkroot} ne ""} {
            append flags " -isysroot [shellescape ${configure.sdkroot}]"
        }
        if {${macosx_deployment_target} ne ""} {
            append flags " -mmacosx-version-min=${macosx_deployment_target}"
        }
        if {${cmd} eq "g++" && ${configure.cxx_stdlib} ne ""} {
            append flags " -stdlib=${configure.cxx_stdlib}"
        }
        set fd [open ${tools}/${cmd} w]
        puts ${fd} "#!/bin/sh"
        puts ${fd} "exec /usr/bin/env CPATH=[shellescape ${prefix}/include:[boost::include_dir]] LIBRARY_PATH=[shellescape ${prefix}/lib:[boost::lib_dir]] [shellescape ${compiler}] ${flags} \"\$@\""
        close ${fd}
        file attributes ${tools}/${cmd} -permissions 0755
    }

    # Match GDB's framework Python flags.
    foreach config [glob ${worksrcpath}/ndless-sdk/toolchain/download/gdb-*/gdb/python/python-config.py] {
        reinplace {s|if getvar("LINKFORSHARED") is not None:|if not getvar("PYTHONFRAMEWORK"):|} ${config}
    }
}

build.cmd           /bin/sh
build.pre_args      .github/packaging/build.sh
build.target
build.env-append    "PATH=${tools}:${prefix}/libexec/gnubin:${prefix}/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
                    "CC=gcc" \
                    "CXX=g++" \
                    "PYTHON=${prefix}/bin/python3.13" \
                    "PARALLEL=-j${build.jobs}"

destroot {
    system -W ${worksrcpath} \
        "/bin/sh .github/packaging/stage.sh [shellescape ${destroot}] [shellescape ${prefix}]"

    foreach script {nspire-tools arm-none-eabi-ld.gold make-prg} {
        reinplace "s|^#!/bin/bash$|#!${prefix}/bin/bash|" \
            ${destroot}${sdk}/bin/${script}
    }
    reinplace "s|realpath|${prefix}/bin/grealpath|g" \
        ${destroot}${sdk}/bin/nspire-tools
    foreach script {nspire-tools arm-none-eabi-ld.gold} {
        reinplace "s|MAKEFLAGS='' make |MAKEFLAGS='' ${prefix}/bin/gmake |g" \
            ${destroot}${sdk}/bin/${script}
    }
}

notes "
This is a rolling source port: each clean fetch checks out the current upstream HEAD.
"
